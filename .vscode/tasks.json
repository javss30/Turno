{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Portfolio: start local server",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "portfolio-server",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Portfolio server starting",
          "endsPattern": "^Portfolio server (listening|already running) at http://127\\.0\\.0\\.1:4173$"
        }
      }
    }
  ]
}
